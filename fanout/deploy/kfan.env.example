# /etc/shred-fanout/kfan.env — read by shred-kfan.service.
# After editing: sudo systemctl restart shred-kfan

# UDP ports the shreds arrive on (one per receiver service; at most 4).
PORTS=5544,23997,23998

# Destinations, ip:port, comma separated: the same list as the proxies'
# --dest-ip-ports (check with: kfan.sh check-dests "$DESTS").
DESTS=127.0.0.1:20200,10.182.192.8:8002,10.182.192.17:8002,10.182.192.36:8002,10.182.192.55:8002,10.182.192.54:8002,10.182.192.67:8002,10.182.192.84:8002,10.182.192.93:8002,10.182.192.33:8002,10.182.192.49:8002,10.182.192.22:20200,185.191.117.135:20200,10.182.192.50:8002,10.182.192.66:20200

# Send straight to the bond's physical ports (the measured setup).
DIRECT=1
DEV=bond0

# Re-resolve next-hop MACs every REFRESH_S seconds; log counters every LOG_S.
REFRESH_S=60
LOG_S=60

# Optional end-to-end measurement: add stamp-recv receivers to DESTS
# (e.g. ...,10.182.192.17:9910, any position) and set their port here.
# With fanout/scripts/xdpstamp.sh attached, the time is taken at the NIC driver.
#STAMP_PORT=9910

# Optional exact box-level latency (probe.sh latency / kfan.sh latency):
# in-kernel histograms from arrival at the NIC driver to each copy handed to
# the NIC. Needs fanout/scripts/xdpstamp.sh attached. 1 = first and last copy,
# 2 = also per destination.
#LAT_HIST=2
