# /etc/shred-fanout/dedup.env — read by shred-dedup.service.
# After editing: sudo systemctl restart shred-dedup

# UDP ports the shreds arrive on (one per source / proxy; at most 4).
PORTS=23998,23999

# Every first copy goes to this port (the tuned proxy), whichever port it
# arrived on. Must be one of PORTS. Leave empty: each proxy keeps its own.
TO_PORT=23998

# While nothing listens on TO_PORT (that proxy down or restarting), first
# copies go here instead (an idle proxy with the same destinations).
# Leave empty for no standby.
STANDBY_PORT=23999

DEV=bond0

# Log the counters (change per interval) every LOG_S seconds.
LOG_S=60
