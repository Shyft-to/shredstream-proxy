[Unit]
Description=Kernel shred dedup (tc eBPF: drop later copies, first copies to one forwarder)
Documentation=file:///opt/shred-fanout/README.md
After=network-online.target
Wants=network-online.target
# Same tc hook as the kernel fan-out: starting either one stops the other
# (the stop, and its detach, always runs before the start).
Conflicts=shred-kfan.service
After=shred-kfan.service

[Service]
Type=simple
EnvironmentFile=/etc/shred-fanout/dedup.env
ExecStart=/opt/shred-fanout/scripts/dedup.sh run ${PORTS}
# Also after a crash: detached, every proxy forwards its own copies again.
ExecStopPost=/opt/shred-fanout/scripts/dedup.sh detach
Restart=on-failure
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
