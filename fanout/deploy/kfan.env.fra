# /etc/shred-fanout/kfan.env for Fra (fra-shred-proxy), from the 2026-11-02 survey.
# After editing: sudo systemctl restart shred-kfan

# everstake (23998) and blockrazor (23999). Not 7733 (doublezero) and not
# 20000 (shredstreams: one local destination of its own); their proxies keep
# forwarding as before.
PORTS=23998,23999

# 23 destinations, the proxies' lists after the 2026-11-02 cleanup (given by
# the operator). Not included: the 6 dead ones, 10.182.192.12:20200 and
# 127.0.0.1:20200 (no local destination: kfan does not touch lo).
DESTS=10.182.192.92:20200,10.182.192.92:20300,10.182.192.97:20200,10.182.192.76:8002,10.182.192.64:8002,10.182.192.45:8002,10.182.192.47:8002,10.184.192.73:8002,10.182.192.11:8002,10.182.192.44:8002,10.182.192.38:8002,10.182.192.19:8002,10.182.192.60:8002,10.182.192.90:8002,10.182.192.77:8002,10.182.192.75:8002,67.213.121.229:8002,67.213.121.225:8002,185.26.10.237:8002,10.182.192.65:8002,160.202.131.7:8002,34.53.145.59:4545,35.195.65.48:4535

DIRECT=1
DEV=bond0

REFRESH_S=60
LOG_S=60
